{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPlayer Next",
  "version": "2.0.0",
  "identifier": "top.imsyy.splayer-next.ios",
  "build": {
    "beforeDevCommand": "pnpm mobile:dev",
    "devUrl": "http://localhost:14558",
    "beforeBuildCommand": "pnpm mobile:build",
    "frontendDist": "../dist-mobile"
  },
  "app": {
    "windows": [
      {
        "title": "SPlayer Next",
        "fullscreen": false,
        "backgroundColor": "#101014"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["mp3", "m4a", "aac", "wav", "flac", "ogg", "opus", "ape"],
        "name": "Audio file",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["orpheus"],
          "appLink": false
        }
      ]
    }
  }
}
