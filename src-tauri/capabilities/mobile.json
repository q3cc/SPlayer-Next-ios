{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions required by the mobile application",
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:default",
    "lyric-pip:default",
    "ipa-update:default",
    "native-audio:default",
    "fs:default",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-read-dir",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DOCUMENT/Imported Music",
        "$DOCUMENT/Imported Music/**",
        "$DOCUMENT/Downloads",
        "$DOCUMENT/Downloads/**"
      ]
    },
    {
      "identifier": "http:default",
      "allow": ["http://**", "https://**"]
    },
    "opener:default",
    "fs:allow-open",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-read",
    "fs:allow-seek"
  ]
}
